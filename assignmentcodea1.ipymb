   "source": [
    "# Standardise the inputs with StandardScaler\n",
    "energy_scaler = StandardScaler()\n",
    "energy_scaler.fit(X_energy)\n",
    "X_energy_scaled = energy_scaler.transform(X_energy)"
   ]
