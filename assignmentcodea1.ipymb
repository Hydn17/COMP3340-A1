   ],
   "source": [
    "# Fit PCA on the standardised data and transform it\n",
    "energy_pca = PCA(n_components=None)\n",
    "energy_pca.fit(X_energy_scaled)\n",
    "energy_scores = energy_pca.transform(X_energy_scaled)\n",
    "\n",
    "print(\"Explained-variance ratio:\", energy_pca.explained_variance_ratio_.round(4))\n",
    "print(\"Shape of the scores:\", energy_scores.shape)"
   ]
  },
