   "source": [
    "# Individual and cumulative contribution of each component\n",
    "energy_individual = energy_pca.explained_variance_ratio_\n",
    "energy_cumulative = np.cumsum(energy_individual)\n",
    "\n",
    "energy_contribution = pd.DataFrame({\n",
    "    \"component\": [\"PC1\", \"PC2\", \"PC3\", \"PC4\"],\n",
    "    \"individual_contribution\": energy_individual,\n",
    "    \"cumulative_contribution\": energy_cumulative\n",
    "})\n",
    "\n",
    "energy_contribution.round(4)"
   ]
  },
