   "source": [
    "# Separate the inputs (X_energy) and the label (y_energy)\n",
    "X_energy = df[numeric_cols]\n",
    "y_energy = df[\"species\"]\n",
    "\n",
    "print(X_energy.shape, y_energy.shape)"
   ]
  },
