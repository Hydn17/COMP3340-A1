   "source": [
    "# Bar chart of individual contributions with a cumulative line\n",
    "component_numbers = np.arange(1, 5)\n",
    "\n",
    "plt.figure(figsize=(6, 4))\n",
    "plt.bar(component_numbers, energy_individual * 100, label=\"Individual\")\n",
    "plt.plot(component_numbers, energy_cumulative * 100, marker=\"o\", color=\"darkorange\", label=\"Cumulative\")\n",
    "\n",
    "plt.xticks(component_numbers)\n",
    "plt.ylim(0, 105)\n",
    "plt.xlabel(\"Principal component\")\n",
    "plt.ylabel(\"Explained variance (%)\")\n",
    "plt.title(\"PCA contribution for the cleaned energy data\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
